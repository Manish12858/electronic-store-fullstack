# Copy this file to .env and change the values before running docker compose
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=electronic_store

# at least 64 characters, used to sign JWT tokens
JWT_SECRET=replace-with-a-long-random-string-replace-with-a-long-random-string

# optional - only needed for "Sign in with Google"
GOOGLE_CLIENT_ID=

DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=admin123
DEMO_USER_EMAIL=user@demo.com
DEMO_USER_PASSWORD=user123
